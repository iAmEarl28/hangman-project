<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            prefHeight="650.0"
            prefWidth="850.0"
            fx:controller="fr.quentincillierre.hangman.controller.DifficultyController">

    <children>

        <Button
                fx:id="backButton"
                layoutX="20.0"
                layoutY="20.0"
                prefWidth="45.0"
                prefHeight="35.0"
                text="←"
                onAction="#goBack"/>

        <Label
                layoutX="325.0"
                layoutY="120.0"
                text="SELECT DIFFICULTY"
                style="-fx-font-size: 24px;" />

        <Button
                layoutX="325.0"
                layoutY="220.0"
                prefWidth="200.0"
                prefHeight="50.0"
                text="Easy"
                onAction="#easyClicked"/>

        <Button
                layoutX="325.0"
                layoutY="300.0"
                prefWidth="200.0"
                prefHeight="50.0"
                text="Medium"
                onAction="#mediumClicked"/>

        <Button
                layoutX="325.0"
                layoutY="380.0"
                prefWidth="200.0"
                prefHeight="50.0"
                text="Hard"
                onAction="#hardClicked"/>

    </children>

</AnchorPane>