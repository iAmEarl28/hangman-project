<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.quentincillierre.hangman.controller.CharacterController">

    <children>

        <Label layoutX="280.0" layoutY="60.0" style="-fx-font-size:24;" text="SELECT YOUR CHARACTER" />

        <Button layoutX="98.0" layoutY="523.0" onAction="#boy1Clicked" prefHeight="30.0" prefWidth="100.0" text="Boy 1" />

        <Button layoutX="330.0" layoutY="180.0" onAction="#boy2Clicked" prefHeight="30.0" prefWidth="100.0" text="Boy 2" />

        <Button layoutX="230.0" layoutY="523.0" onAction="#girl1Clicked" prefHeight="30.0" prefWidth="100.0" text="Girl 1" />

        <Button layoutX="500.0" layoutY="523.0" onAction="#girl2Clicked" prefHeight="30.0" prefWidth="100.0" text="Girl 2" />

        <Button layoutX="460.0" layoutY="360.0" onAction="#robotClicked" prefHeight="120.0" prefWidth="180.0" text="Robot" />

    </children>

</AnchorPane>
