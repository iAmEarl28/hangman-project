<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane
        xmlns="http://javafx.com/javafx/24.0.1"
        xmlns:fx="http://javafx.com/fxml/1"
        prefHeight="650.0"
        prefWidth="850.0"
        fx:controller="fr.quentincillierre.hangman.controller.CharacterController">

    <children>

        <Label
                layoutX="280.0"
                layoutY="60.0"
                text="SELECT YOUR CHARACTER"
                style="-fx-font-size:24;" />

        <Button
                layoutX="100.0"
                layoutY="180.0"
                prefWidth="180.0"
                prefHeight="120.0"
                text="Boy 1"
                onAction="#boy1Clicked"/>

        <Button
                layoutX="330.0"
                layoutY="180.0"
                prefWidth="180.0"
                prefHeight="120.0"
                text="Boy 2"
                onAction="#boy2Clicked"/>

        <Button
                layoutX="560.0"
                layoutY="180.0"
                prefWidth="180.0"
                prefHeight="120.0"
                text="Girl 1"
                onAction="#girl1Clicked"/>

        <Button
                layoutX="210.0"
                layoutY="360.0"
                prefWidth="180.0"
                prefHeight="120.0"
                text="Girl 2"
                onAction="#girl2Clicked"/>

        <Button
                layoutX="460.0"
                layoutY="360.0"
                prefWidth="180.0"
                prefHeight="120.0"
                text="Robot"
                onAction="#robotClicked"/>

    </children>

</AnchorPane>