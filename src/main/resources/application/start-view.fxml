<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefHeight="650"
            prefWidth="850"
            fx:controller="fr.quentincillierre.hangman.controller.StartController">

    <children>

        <Button
                fx:id="startButton"
                layoutX="350"
                layoutY="300"
                mnemonicParsing="false"
                onAction="#startGame"
                prefHeight="50"
                prefWidth="150"
                text="START"/>

    </children>

</AnchorPane>