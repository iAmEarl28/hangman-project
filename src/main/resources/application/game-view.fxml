<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>

<AnchorPane prefHeight="650.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.quentincillierre.hangman.controller.GameController">

    <children>

        <Button fx:id="backButton" layoutX="20" layoutY="20" prefHeight="35" prefWidth="45" text="←" />

        <Label fx:id="categoryLabel" layoutX="100" layoutY="25" text="Category" />

        <Label fx:id="difficultyLabel" layoutX="250" layoutY="25" text="Difficulty" />

        <Label fx:id="diamondLabel" layoutX="420" layoutY="25" text="Diamonds: 0" />

        <Label fx:id="timerLabel" layoutX="719.0" layoutY="25.0" text="60" />

        <ImageView fx:id="hangmanImageView" fitHeight="250" fitWidth="250" layoutX="40.0" layoutY="90.0" />

        <Label fx:id="definitionLabel" layoutX="345.0" layoutY="215.0" prefWidth="450" text="Definition" />

        <Label fx:id="wordLabel" layoutX="487.0" layoutY="157.0" style="-fx-font-size:26;" text="_ _ _ _ _" />

        <Button fx:id="hintButton" layoutX="337.0" layoutY="252.0" prefHeight="38.0" prefWidth="149.0" text="Buy Hint (10 Diamonds)" />

        <GridPane fx:id="keyboardGrid" layoutX="179.0" layoutY="462.0" prefHeight="250.0" prefWidth="781.0" />

        <Label fx:id="attemptsLabel" layoutX="43.0" layoutY="608.0" text="Attempts: 10" />

              <Label fx:id="streakLabel" layoutX="570.0" layoutY="25.0" text="Streak: 0" />

        <Label fx:id="highStreakLabel" layoutX="570.0" layoutY="46.0" text="Highest: 0" />

        <Label fx:id="resultLabel" layoutX="33.0" layoutY="306.0" prefHeight="54.0" prefWidth="460.0" style="-fx-font-size:16; -fx-text-fill:#333333;" text="" />

        <Button fx:id="tryAgainButton" layoutX="118.0" layoutY="360.0" prefHeight="35.0" prefWidth="83.0" text="Continue" visible="false" />

    </children>

</AnchorPane>
