<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>

<AnchorPane
        xmlns="http://javafx.com/javafx/24.0.1"
        xmlns:fx="http://javafx.com/fxml/1"
        prefHeight="650.0"
        prefWidth="850.0"
        fx:controller="fr.quentincillierre.hangman.controller.GameController">

    <children>

        <Button
                fx:id="backButton"
                layoutX="20"
                layoutY="20"
                prefWidth="45"
                prefHeight="35"
                text="←"/>

        <Label
                fx:id="categoryLabel"
                layoutX="100"
                layoutY="25"
                text="Category"/>

        <Label
                fx:id="difficultyLabel"
                layoutX="250"
                layoutY="25"
                text="Difficulty"/>

        <Label
                fx:id="diamondLabel"
                layoutX="420"
                layoutY="25"
                text="Diamonds: 0"/>

        <Label
                fx:id="timerLabel"
                layoutX="650"
                layoutY="25"
                text="60"/>

        <ImageView
                fx:id="hangmanImage"
                fitHeight="250"
                fitWidth="250"
                layoutX="40"
                layoutY="90"/>

        <Label
                fx:id="definitionLabel"
                layoutX="340"
                layoutY="110"
                prefWidth="450"
                text="Definition"/>

        <Label
                fx:id="wordLabel"
                layoutX="340"
                layoutY="170"
                style="-fx-font-size:26;"
                text="_ _ _ _ _"/>

        <Button
                fx:id="hintButton"
                layoutX="340"
                layoutY="230"
                text="Buy Hint (10 Diamonds)"/>

        <GridPane
                fx:id="keyboardGrid"
                layoutX="150"
                layoutY="350"
                prefHeight="220"
                prefWidth="550"/>

        <Label
                fx:id="attemptLabel"
                layoutX="40"
                layoutY="570"
                text="Attempts: 6"/>

        <Label
                fx:id="streakLabel"
                layoutX="220"
                layoutY="570"
                text="Streak: 0"/>

        <Label
                fx:id="highestStreakLabel"
                layoutX="420"
                layoutY="570"
                text="Highest: 0"/>

    </children>

</AnchorPane>