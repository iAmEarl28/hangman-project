<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650" prefWidth="850" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.quentincillierre.hangman.controller.CharacterController">

    <children>

        <!-- BorderPane fills the whole AnchorPane -->
        <BorderPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

            <!-- ===== TOP BAR ===== -->
            <top>
                <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="0">
                    <padding><Insets bottom="8" left="18" right="18" top="18" /></padding>

                    <Button fx:id="backButton" onAction="#goBack" prefHeight="42" prefWidth="42" styleClass="icon-button" text="←" />

                    <Region HBox.hgrow="ALWAYS" />

                    <Label styleClass="section-title" text="Please Select A Cutie Character to Hang..." />

                    <Region HBox.hgrow="ALWAYS" />

                    <Label fx:id="diamondDisplayLabel" styleClass="chip,diamond-chip" text="💎 0" />
                </HBox>
            </top>

            <!-- ===== CHARACTER COLUMNS (center fills remaining space) ===== -->
            <center>
                <HBox alignment="BOTTOM_CENTER" maxWidth="Infinity" spacing="14" BorderPane.alignment="CENTER">
                    <padding><Insets bottom="14" left="20" right="20" top="0" /></padding>

                    <!-- JOEY-kun (boy1) – FREE -->
                    <VBox alignment="BOTTOM_CENTER" maxWidth="Infinity" spacing="6" HBox.hgrow="ALWAYS">
                        <ImageView fx:id="boy1Img" fitHeight="188.0" fitWidth="111.0" preserveRatio="true">
                            <image><Image url="@characters_pg3/boy1.png" /></image>
                        </ImageView>
                        <Button fx:id="boy1Button" contentDisplay="TOP" graphicTextGap="8" onAction="#boy1Clicked" prefWidth="148" styleClass="character-card" text="JOEY-kun" />
                        <Label fx:id="boy1DefLabel" alignment="CENTER" prefWidth="148" styleClass="character-def-label" text="The cheerful beginner cutie who loves solving word puzzles!" textAlignment="CENTER" wrapText="true" />
                    </VBox>

                    <!-- LON-kun (girl1) -->
                    <VBox alignment="BOTTOM_CENTER" maxWidth="Infinity" spacing="6" HBox.hgrow="ALWAYS">
                        <ImageView fx:id="girl1Img" fitHeight="236.0" fitWidth="143.0" preserveRatio="true">
                            <image><Image url="@characters_pg3/girl1.png" /></image>
                        </ImageView>
                        <Button fx:id="girl1Button" contentDisplay="TOP" graphicTextGap="8" onAction="#girl1Clicked" prefWidth="148" styleClass="character-card" text="LON-kun" />
                        <Label fx:id="girl1DefLabel" alignment="CENTER" prefWidth="148" styleClass="character-def-label" text="A quiet scholar who rewards you with +1 extra diamond when saved." textAlignment="CENTER" wrapText="true" />
                    </VBox>

                    <!-- JOBOY-kun (boy2) -->
                    <VBox alignment="BOTTOM_CENTER" maxWidth="Infinity" spacing="6" HBox.hgrow="ALWAYS">
                        <ImageView fx:id="boy2Img" fitHeight="219.0" fitWidth="124.0" preserveRatio="true">
                            <image><Image url="@characters_pg3/boy2.png" /></image>
                        </ImageView>
                        <Button fx:id="boy2Button" contentDisplay="TOP" graphicTextGap="8" onAction="#boy2Clicked" prefWidth="148" styleClass="character-card" text="JOBOY-kun" />
                        <Label fx:id="boy2DefLabel" alignment="CENTER" prefWidth="148" styleClass="character-def-label" text="An energetic adventurer who gives you +2 extra diamonds when saved." textAlignment="CENTER" wrapText="true" />
                    </VBox>

                    <!-- KAREN-kun (girl2) -->
                    <VBox alignment="BOTTOM_CENTER" maxWidth="Infinity" spacing="6" HBox.hgrow="ALWAYS">
                        <ImageView fx:id="girl2Img" fitHeight="232.0" fitWidth="152.0" preserveRatio="true">
                            <image><Image url="@characters_pg3/girl2.png" /></image>
                        </ImageView>
                        <Button fx:id="girl2Button" contentDisplay="TOP" graphicTextGap="8" onAction="#girl2Clicked" prefWidth="148" styleClass="character-card" text="KAREN-kun" />
                        <Label fx:id="girl2DefLabel" alignment="CENTER" prefWidth="148" styleClass="character-def-label" text="A sharp strategist who grants +3 extra diamonds when saved." textAlignment="CENTER" wrapText="true" />
                    </VBox>

                    <!-- JOHNNY-kun (robot) -->
                    <VBox alignment="BOTTOM_CENTER" maxWidth="Infinity" spacing="6" HBox.hgrow="ALWAYS">
                        <ImageView fx:id="robotImg" fitHeight="280.0" fitWidth="155.0" preserveRatio="true">
                            <image><Image url="@characters_pg3/boy3.png" /></image>
                        </ImageView>
                        <Button fx:id="robotButton" contentDisplay="TOP" graphicTextGap="8" onAction="#robotClicked" prefWidth="148" styleClass="character-card" text="JOHNNY-kun" />
                        <Label fx:id="robotDefLabel" alignment="CENTER" prefWidth="148" styleClass="character-def-label" text="The legendary hero who bestows maximum +5 extra diamonds when saved!" textAlignment="CENTER" wrapText="true" />
                    </VBox>

                </HBox>
            </center>

        </BorderPane>

    </children>

</AnchorPane>
