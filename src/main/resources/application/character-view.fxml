<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650" prefWidth="850" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.quentincillierre.hangman.controller.CharacterController">

    <children>
     
      <HBox alignment="BOTTOM_CENTER" layoutX="14.0" pickOnBounds="false" prefHeight="630.0" prefWidth="822.0" spacing="12">

         <children>
            
            <VBox alignment="BOTTOM_CENTER" prefWidth="152.0" spacing="6">
               <children>
                       <ImageView fx:id="boy1Img" fitHeight="306.0" fitWidth="176.0" preserveRatio="true">
                     <image>
                         <!-- Path relative to the current FXML file or root resources directory -->
                         <Image url="@characters_pg3/boy1.png" />
                     </image>
                      </ImageView>
                  <Button fx:id="boy1Button" contentDisplay="TOP" graphicTextGap="8" onAction="#boy1Clicked" prefWidth="152.0" styleClass="character-card" text="JOEY-kun" />
                  <Label fx:id="boy1DefLabel" alignment="CENTER" prefWidth="152.0" styleClass="character-def-label" text="The cheerful beginner cutie who loves solving word puzzles!" textAlignment="CENTER" wrapText="true" />
               </children>
            </VBox>

            <VBox alignment="BOTTOM_CENTER" prefHeight="631.0" prefWidth="163.0" spacing="6">
               <children>
                  <Button fx:id="girl1Button" contentDisplay="TOP" graphicTextGap="8" onAction="#girl1Clicked" prefWidth="152.0" styleClass="character-card" text="LON-kun" />
                  <Label fx:id="girl1DefLabel" alignment="CENTER" prefWidth="152.0" styleClass="character-def-label" text="A quiet scholar who rewards you with +1 extra diamond when saved." textAlignment="CENTER" wrapText="true" />
               </children>
            </VBox>

            <VBox alignment="BOTTOM_CENTER" prefWidth="152.0" spacing="6">
               <children>
                  <Button fx:id="boy2Button" contentDisplay="TOP" graphicTextGap="8" onAction="#boy2Clicked" prefWidth="152.0" styleClass="character-card" text="JOBOY-kun" />
                  <Label fx:id="boy2DefLabel" alignment="CENTER" prefWidth="152.0" styleClass="character-def-label" text="An energetic adventurer who gives you +2 extra diamonds when saved." textAlignment="CENTER" wrapText="true" />
               </children>
            </VBox>

            <VBox alignment="BOTTOM_CENTER" prefWidth="152.0" spacing="6">
               <children>
                  <Button fx:id="girl2Button" contentDisplay="TOP" graphicTextGap="8" onAction="#girl2Clicked" prefWidth="152.0" styleClass="character-card" text="KAREN-kun" />
                  <Label fx:id="girl2DefLabel" alignment="CENTER" prefWidth="152.0" styleClass="character-def-label" text="A sharp strategist who grants +3 extra diamonds when saved." textAlignment="CENTER" wrapText="true" />
               </children>
            </VBox>

            <VBox alignment="BOTTOM_CENTER" prefWidth="152.0" spacing="6">
               <children>
                  <Button fx:id="robotButton" contentDisplay="TOP" graphicTextGap="8" onAction="#robotClicked" prefWidth="152.0" styleClass="character-card" text="JOHNNY-kun" />
                  <Label fx:id="robotDefLabel" alignment="CENTER" prefWidth="152.0" styleClass="character-def-label" text="The legendary hero who bestows maximum +5 extra diamonds when saved!" textAlignment="CENTER" wrapText="true" />
               </children>
            </VBox>

         </children>
      </HBox>
         <ImageView fx:id="boy2Img" fitHeight="362.0" fitWidth="211.0" layoutX="314.0" layoutY="150.0" preserveRatio="true">
         <image>
             <!-- Path relative to the current FXML file or root resources directory -->
             <Image url="@characters_pg3/boy2.png" />
         </image>
          </ImageView>
          <ImageView fx:id="girl1Img" fitHeight="397.0" fitWidth="237.0" layoutX="147.0" layoutY="89.0" preserveRatio="true">
         <image>
             <!-- Path relative to the current FXML file or root resources directory -->
             <Image url="@characters_pg3/girl1.png" />
         </image>
          </ImageView>
           <ImageView fx:id="girl2Img" fitHeight="390.0" fitWidth="210.0" layoutX="481.0" layoutY="123.0" preserveRatio="true">
         <image>
             <!-- Path relative to the current FXML file or root resources directory -->
             <Image url="@characters_pg3/girl2.png" />
         </image>
          </ImageView>
           <ImageView fx:id="robotImg" fitHeight="349.0" fitWidth="256.0" layoutX="631.0" layoutY="142.0" preserveRatio="true">
         <image>
             <!-- Path relative to the current FXML file or root resources directory -->
             <Image url="@characters_pg3/boy3.png" />
         </image>
          </ImageView>

      <Button fx:id="backButton" layoutX="41.0" layoutY="24.0" onAction="#goBack" prefHeight="42.0" prefWidth="42.0" styleClass="icon-button" text="←" />
      <Label layoutX="188.0" layoutY="45.0" styleClass="section-title" text="Please Select A Cutie Character to Hang..." />
      <Label fx:id="diamondDisplayLabel" layoutX="799.0" layoutY="10.0" styleClass="chip,diamond-chip" text="💎 0" />

    </children>

</AnchorPane>
